{
  "name": "dsh-plugin-skin-studio",
  "version": "1.0.19",
  "type": "module",
  "description": "皮肤与壁纸插件：8 套预设与自定义配色、渐变/图片/视频聊天壁纸、收藏与实时预览，数据只存本机。",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "skin",
    "theme",
    "wallpaper",
    "video-wallpaper",
    "换肤",
    "壁纸"
  ],
  "license": "MIT",
  "author": "ghostmss86-afk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghostmss86-afk/dsh-skin-studio.git"
  },
  "homepage": "https://github.com/ghostmss86-afk/dsh-skin-studio#readme",
  "bugs": {
    "url": "https://github.com/ghostmss86-afk/dsh-skin-studio/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "icon-180.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "scripts": {
    "check": "node --check client.js && node --check index.js && node scripts/check-modes.mjs && node scripts/check-media.mjs && node scripts/check-host.mjs",
    "version:check": "node scripts/check-version.mjs .",
    "guard": "node scripts/guard.mjs --root . --rules scripts/guard.rules.json",
    "verify": "npm run check && npm run version:check && npm run guard",
    "bump": "node scripts/bump.mjs",
    "prepublishOnly": "npm run verify",
    "media:check": "node scripts/check-media.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
